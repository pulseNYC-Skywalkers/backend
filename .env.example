# Copy to .env and fill in. The pipeline reads these via config/settings.py.

# --- Source EHR API ---
# Defaults to the bundled local mock (mock_api/server.py), which faithfully
# emulates the PCC contract in API.md. To hit the real hackathon API instead:
#   EHR_API_BASE_URL=https://hackathon.prod.pulsefoundry.ai
EHR_API_BASE_URL=http://127.0.0.1:8099
EHR_API_KEY=
EHR_ADAPTER_VERSION=pcc_v1
EHR_FACILITY_IDS=101,102,103
# Real API has non-uniform facility sizes (120/90/90 = 300). 0 disables the
# fixed-count pagination-gap check (avoids false positives); set per-facility
# only if you have a known expected count.
EHR_EXPECTED_PER_FACILITY=0

# --- Resilience knobs ---
FETCH_MAX_CONCURRENCY=8
FETCH_MAX_ATTEMPTS=6
FETCH_BASE_BACKOFF_SECONDS=0.5
FETCH_MAX_BACKOFF_SECONDS=30
# Circuit breaker trips only on REAL failures (5xx / timeout / conn refused), never on 429.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=10
BREAKER_HALFOPEN_PROBES=3

# --- Storage ---
DUCKDB_PATH=data/wound_care.duckdb

# --- Mock API behaviour (local dev only; matches API.md defaults) ---
MOCK_THROTTLE_RATE=0.30        # ~30% of requests return 429 (per API.md)
MOCK_OUTAGE_RATE=0.02          # fraction that return 5xx (exercises the breaker)
MOCK_PATIENTS_PER_FACILITY=100
MOCK_SEED=42
MOCK_RETRY_AFTER_MIN=1
MOCK_RETRY_AFTER_MAX=5
# Edge-case injection (set >0 to validate handling; 0 = clean run):
MOCK_MALFORMED_RATE=0.0        # truncated/invalid JSON bodies
MOCK_EMPTY_RATE=0.0            # 200 OK but empty -> no_data
MOCK_DROP_RETRY_AFTER=0.15     # 429s without a Retry-After header
MOCK_UNKNOWN_FIELD_RATE=0.0    # contract drift (unexpected field)

# --- Extraction (Milestone 2) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
